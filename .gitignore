# Generierte Artefakte (werden lokal erzeugt, gehoeren nicht ins Repo).
# Beispieldaten entstehen deterministisch aus src/sample_data.py (von
# init_db.py / app.py automatisch); echte Historie via --fetch.
db/
models/
data/*.csv

# Grosse Roh-Spielerdaten bleiben draussen (11 MB; online ladbar via
# scripts/build_wm2026.py --refresh). Die fertig bewerteten Kader inkl. aller
# Attribute liegen ohnehin in data/wm2026_squads.csv vor.
/data/fc26_players.csv
/data/fifa_players.csv

# ...aber die WM-2026-ERGEBNIS-Tabellen UND die echte Historie werden
# eingecheckt, damit alles ohne Download laeuft ("alle Daten vorhanden"):
!data/international_results.csv
!data/wm2026_squads.csv
!data/wm2026_player_ratings.csv
!data/wm2026_team_ratings.csv
!data/wm2026_fixtures.csv
!data/wm2026_predictions.csv
!data/wm2026_group_sim.csv
!data/wm2026_knockout_probs.csv
!data/wm2026_bracket.csv

